<launch>
    <arg name="odometry_topic"/>
    <arg name="camera_pose_topic"/>
    <arg name="depth_topic"/>
    <arg name="cloud_topic"/>
    <arg name="cx"/>
    <arg name="cy"/>
    <arg name="fx"/>
    <arg name="fy"/>
    <arg name="drone_id"/>
    <arg name="tracking_target_odom_topic" default="/target_ekf_odom"/>
    <arg name="planner_cmd_mux_ego_topic" default="/planner_mux/ego_position_cmd"/>
    <arg name="planner_cmd_mux_elastic_topic" default="/planner_mux/elastic_position_cmd"/>
    <arg name="planner_cmd_mux_output_topic" default="/drone_0_planning/pos_cmd"/>

    <!-- Scene graph config (passed by sim_scenegraph modes, ignored in sim_random) -->
    <arg name="auto_load_scene_graph" default="false"/>
    <arg name="scene_graph_data_path" default=""/>
    <arg name="scene_graph_load_name" default=""/>
    <arg name="object_id_nav_autostart_enable" default="false"/>
    <arg name="object_id_nav_autostart_target_id" default="2"/>
    <arg name="object_id_nav_autostart_delay_sec" default="1.0"/>

    <!-- EGO replan switch (false = external local planner e.g. SUPER) -->
    <arg name="enable_ego_replan" default="true"/>

    <!-- main node: mission_executive_node (MissionFSM + GridMap + tracking) -->
    <node pkg="mission_executive" name="drone_$(arg drone_id)_ego_planner_node" type="mission_executive_node" output="screen">
        <remap from="~odom_world" to="/drone_$(arg drone_id)_$(arg odometry_topic)"/>
        <remap from="~mandatory_stop" to="/mandatory_stop_to_planner"/>
        <remap from="~planning/trajectory" to = "/drone_$(arg drone_id)_planning/trajectory"/>
        <remap from="~planning/data_display" to = "/drone_$(arg drone_id)_planning/data_display"/>
        <remap from="~planning/yaw_cmd" to = "/drone_$(arg drone_id)_planning/yaw_cmd"/>
        <remap from="~planning/broadcast_traj_send" to = "/broadcast_traj_from_planner"/>
        <remap from="~planning/broadcast_traj_recv" to = "/bridge/broadcast_traj_from_planner"/>
        <remap from="~planning/heartbeat" to = "/drone_$(arg drone_id)_traj_server/heartbeat"/>
        <remap from ="/trigger" to="/move_base_simple/goal"/>
        <remap from="~grid_map/odom" to="/drone_$(arg drone_id)_$(arg odometry_topic)"/>
        <remap from="~grid_map/cloud" to="$(arg cloud_topic)"/>
        <remap from="~grid_map/pose"   to = "/drone_$(arg drone_id)_$(arg camera_pose_topic)"/>
        <remap from="~grid_map/depth" to = "/drone_$(arg drone_id)_$(arg depth_topic)"/>
        <!-- EGO planner /position_cmd → mux ego input -->
        <remap from="/position_cmd" to="$(arg planner_cmd_mux_ego_topic)"/>
        <!-- Integrated mux: subscribe to both planners, publish selected output -->
        <remap from="~ego_position_cmd" to="$(arg planner_cmd_mux_ego_topic)"/>
        <remap from="~elastic_position_cmd" to="$(arg planner_cmd_mux_elastic_topic)"/>
        <remap from="~position_cmd" to="$(arg planner_cmd_mux_output_topic)"/>
        <remap from="/tracking_target" to="/target_dist_calculator/detect_out"/>

        <!-- FSM -->
        <param name="fsm/enable_ego_replan" value="$(arg enable_ego_replan)" type="bool"/>
        <param name="fsm/ground_height_measurement" value="true" type="bool"/>
        <param name="fsm/scale" value="1.0" type="double"/>
        <param name="fsm/drone_id" value="$(arg drone_id)"/>
        <param name="fsm/arrive_dis_thr" value="0.2"/>
        <param name="fsm/odom_buffer_dis_threshold" value="0.05"/>
        <param name="fsm/follower_dis" value="0.8"/>
        <param name="fsm/realworld_experiment" value="false"/>
        <param name="fsm/fail_safe" value="true"/>
        <param name="fsm/battery_thr" value="14.0" type="double"/>
        <param name="fsm/enable_area_prediction" value="true" type="bool"/>
        <param name="fsm/enable_scene_graph_update_after_load" value="true" type="bool"/>
        <param name="fsm/auto_init_scene_graph" value="true" type="bool"/>
        <param name="fsm/auto_init_delay_sec" value="2.0" type="double"/>
        <param name="fsm/scene_graph_init_forward_dist" value="1.8" type="double"/>
        <param name="fsm/panorama_max_step" value="120.0" type="double"/>
        <param name="fsm/panorama_extend_angle" value="40.0" type="double"/>
        <param name="fsm/enable_yaw_scan" value="false" type="bool"/>
        <param name="fsm/thresh_replan1" value="0.5" type="double"/>
        <param name="fsm/thresh_replan2" value="1.5" type="double"/>
        <param name="fsm/thresh_replan3" value="15.0" type="double"/>
        <param name="fsm/replan_time" value="0.200" type="double"/>
        <param name="fsm/target_cmd" value="Find shelf full of stroage boxes" type="string"/>

        <!-- Scene graph auto-load -->
        <param name="fsm/auto_load_scene_graph"   type="bool"   value="$(arg auto_load_scene_graph)"/>
        <param name="fsm/scene_graph_data_path"   type="string" value="$(arg scene_graph_data_path)"/>
        <param name="fsm/scene_graph_load_name"   type="string" value="$(arg scene_graph_load_name)"/>

        <!-- VLA_Swarm -->
        <param name="vla_search/enable" value="true" type="bool"/>
        <param name="vla_search/result_topic" value="/planning/vla_search_result" type="string"/>
        <param name="vla_search/bbox_topic" value="/vla_search/bbox" type="string"/>
        <param name="vla_search/bbox_fallback_topic" value="/vla_search/bbox/fallback" type="string"/>
        <param name="vla_search/target_topic" value="/vla_search/target" type="string"/>
        <param name="vla_search/camera_topic" value="/camera1/color_sync/image/compressed" type="string"/>
        <param name="vla_search/observation_topic" value="/vla_search/observation" type="string"/>
        <param name="vla_search/prompt_timeout" value="20.0" type="double"/>
        <param name="vla_search/target_timeout" value="10.0" type="double"/>
        <param name="vla_search/ego_plan_timeout" value="5.0" type="double"/>
        <param name="vla_search/ego_exec_timeout" value="30.0" type="double"/>
        <param name="vla_search/max_plan_retries" value="2" type="int"/>
        <param name="vla_search/max_target_retries" value="2" type="int"/>
        <param name="vla_search/max_exploration_rounds" value="6" type="int"/>
        <param name="vla_search/enable_room_description" value="false" type="bool"/>
        <param name="vla_search/waypoint_distance" value="2.0" type="double"/>
        <param name="vla_search/goal_tolerance" value="0.5" type="double"/>
        <param name="vla_search/flight_height" value="1.0" type="double"/>
        <param name="vla_search/scan_yaw_step_deg" value="60.0" type="double"/>
        <param name="vla_search/scan_yaw_tolerance" value="0.08" type="double"/>
        <param name="vla_search/scan_settle_time" value="0.4" type="double"/>
        <param name="vla_search/scan_timeout" value="8.0" type="double"/>
        <param name="vla_search/small_map_topic" value="/vla_search/small_map" type="string"/>
        <param name="vla_search/small_map_frame" value="world" type="string"/>
        <param name="vla_search/small_map_width" value="320" type="int"/>
        <param name="vla_search/small_map_height" value="240" type="int"/>
        <param name="vla_search/map_update_period" value="1.0" type="double"/>
        <param name="vla_search/map_height_min" value="0.6" type="double"/>
        <param name="vla_search/map_height_max" value="1.6" type="double"/>
        <param name="vla_search/map_height_step" value="0.4" type="double"/>
        <param name="vla_search/min_room_area_px" value="300" type="int"/>
        <param name="vla_search/room_erode_iterations" value="4" type="int"/>
        <param name="vla_search/door_min_width_px" value="4" type="int"/>
        <param name="vla_search/door_max_width_px" value="30" type="int"/>
        <param name="vla_search/door_merge_distance_px" value="12" type="int"/>
        <param name="vla_search/astar_clearance_px" value="2" type="int"/>

        <!-- grid_map -->
        <param name="grid_map/local_update_range_x" value="8.0" />
        <param name="grid_map/local_update_range_y" value="8.0" />
        <param name="grid_map/local_update_range_z" value="4.0" />
        <param name="grid_map/obstacles_inflation" value="0.2" />
        <param name="grid_map/enable_virtual_wall" value="false"/>
        <param name="grid_map/virtual_ceil" value="3.0"/>
        <param name="grid_map/virtual_ground" value="-0.1"/>
        <param name="grid_map/visual_inflat_map_height" value="2.0"/>
        <param name="grid_map/cx" value="$(arg cx)"/>
        <param name="grid_map/cy" value="$(arg cy)"/>
        <param name="grid_map/fx" value="$(arg fx)"/>
        <param name="grid_map/fy" value="$(arg fy)"/>
        <param name="grid_map/k_depth_scaling_factor" value="1.0"/>
        <param name="grid_map/skip_pixel" value="2"/>
        <param name="grid_map/depth_filter_maxdist"   value="4.5"/>
        <param name="grid_map/depth_filter_mindist"   value="0.1"/>
        <param name="grid_map/depth_filter_margin"    value="2"/>
        <param name="grid_map/p_hit" value="0.90"/>
        <param name="grid_map/p_miss" value="0.45"/>
        <param name="grid_map/p_min" value="0.12"/>
        <param name="grid_map/p_max" value="0.90"/>
        <param name="grid_map/p_occ" value="0.80"/>
        <param name="grid_map/fading_time" value="-1.0"/>
        <param name="grid_map/min_ray_length" value="0.1"/>
        <param name="grid_map/max_ray_length" value="4.0"/>
        <param name="grid_map/show_occ_time" value="false"/>
        <param name="grid_map/input_mode" value="cloud"/>
        <param name="grid_map/pose_type" value="2"/>
        <param name="grid_map/frame_id" value="world"/>
        <param name="grid_map/hit_accum_max" value="40" /> 
        <param name="grid_map/hit_accum_threshold" value="10" />

        <!-- camera_fov -->
        <param name="camera_fov/top_angle" value="0.6" type="double"/>
        <param name="camera_fov/left_angle" value="0.76" type="double"/>
        <param name="camera_fov/right_angle" value="0.76" type="double"/>
        <param name="camera_fov/max_dist" value="6.0" type="double"/>
        <param name="camera_fov/vis_dist" value="1.0" type="double"/>

        <!-- tracking (dead keys removed: track_dist, dist_far, fly_yaw_threshold, yaw_threshold) -->
        <param name="tracking/target_odom_topic" value="$(arg tracking_target_odom_topic)" type="string"/>
        <param name="tracking/replan_dist" value="0.25" type="double"/>
        <param name="tracking/turn_yaw_dist" value="100.0" type="double"/>
        <param name="tracking/detect_error" value="2.0" type="double"/>
        <param name="tracking/finish_hold_time" value="3.0" type="double"/>
        <param name="tracking/finish_move_thresh" value="0.2" type="double"/>
        <param name="tracking/finish_yaw_thresh" value="0.2" type="double"/>

        <!-- planner_cmd_mux -->
        <param name="planner_cmd_mux/ego_mode" value="ego" type="string"/>

        <!-- object-id-nav -->
        <param name="object_id_nav_replan/enable"                  type="bool"   value="true"/>
        <param name="object_id_nav_replan/mode"                    type="int"    value="0"/>
        <param name="object_id_nav_replan/stuck_vel_thresh"        type="double" value="0.1"/>
        <param name="object_id_nav_replan/stuck_yaw_rate_thresh"   type="double" value="0.1"/>
        <param name="object_id_nav_replan/stuck_duration"          type="double" value="3.0"/>
        <param name="object_id_nav_replan/stuck_max_consecutive"   type="int"    value="0"/>
        <param name="object_id_nav_replan/mode2_stuck_fallback_delay" type="double" value="3.0"/>
        <param name="object_id_nav/require_final_yaw"              type="bool"   value="false"/>
        <param name="object_id_nav/autostart_enable"               type="bool"   value="$(arg object_id_nav_autostart_enable)"/>
        <param name="object_id_nav/autostart_target_id"            type="int"    value="$(arg object_id_nav_autostart_target_id)"/>
        <param name="object_id_nav/autostart_delay_sec"            type="double" value="$(arg object_id_nav_autostart_delay_sec)"/>
    </node>

    <!-- RC replan trigger -->
    <node pkg="mission_executive" name="rc_replan_trigger" type="rc_replan_trigger" output="screen"/>
</launch>
