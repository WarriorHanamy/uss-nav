<launch>
  <arg name="drone_id" default="0"/>
  <arg name="init_x" default="0.0"/>
  <arg name="init_y" default="0.0"/>
  <arg name="init_z" default="1.0"/>
  <arg name="flight_type" default="2"/>
  <arg name="max_vel" default="0.6"/>
  <arg name="max_acc" default="1.0"/>

  <!-- PCD map path (mounted from .data/pcd/) -->
  <arg name="map_pcd" default="/workspace/.data/pcd/J30V2_latest.pcd"/>

  <!-- Scene graph snapshot name (under .data/scene_graph/) -->
  <arg name="scene_graph_name" default="J30V2_snapshot"/>

  <!-- PCD map + quadrotor simulation + 360° LiDAR sensor -->
  <include file="$(find bringup_test)/launch/sim_scenegraph_sim.launch">
    <arg name="drone_id" value="$(arg drone_id)"/>
    <arg name="init_x" value="$(arg init_x)"/>
    <arg name="init_y" value="$(arg init_y)"/>
    <arg name="init_z" value="$(arg init_z)"/>
    <arg name="map_pcd" value="$(arg map_pcd)"/>
  </include>

  <!-- EGO planner + offline scene graph auto-load -->
  <include file="$(find bringup_test)/launch/sim_scenegraph_planner.launch">
    <arg name="drone_id" value="$(arg drone_id)"/>
    <arg name="flight_type" value="$(arg flight_type)"/>
    <arg name="max_vel" value="$(arg max_vel)"/>
    <arg name="max_acc" value="$(arg max_acc)"/>
    <arg name="scene_graph_name" value="$(arg scene_graph_name)"/>
  </include>
</launch>
