<launch>
  <arg name="drone_id" default="0"/>
  <arg name="init_x" default="0.0"/>
  <arg name="init_y" default="0.0"/>
  <arg name="init_z" default="1.0"/>
  <arg name="uav_mass" default="1.64"/>
  <arg name="uav_grav" default="9.81"/>
  <arg name="map_pcd" default="/workspace/.data/pcd/J30V2-rec-latest.pcd"/>

  <!-- prior_local support cloud (ported from FAST_LIO prior_local):
       cut a local patch from a prior PCD around current pose and merge
       it into the simulated LiDAR scan to assist mapping -->
  <arg name="support_pcd_enable" default="true"/>
  <arg name="support_pcd" default="/workspace/.data/pcd/20260705-magic2-d0.05.pcd"/>
  <arg name="cloud_out" value="/livox/lidar_world_raw" if="$(arg support_pcd_enable)"/>
  <arg name="cloud_out" value="/livox/lidar_world" unless="$(arg support_pcd_enable)"/>

  <!-- PCD map publisher (global occupancy map) -->
  <node pkg="map_generator" name="map_pub" type="map_pub" output="screen"
        args="$(arg map_pcd)">
    <param name="add_boundary" value="0"/>
    <param name="add_boundary2" value="0"/>
    <param name="is_bridge" value="0"/>
    <param name="downsample_res" value="0.2"/>
    <param name="map_offset_x" value="0.0"/>
    <param name="map_offset_y" value="0.0"/>
    <param name="map_offset_z" value="0.0"/>
  </node>
  <node pkg="map_generator" name="map_display" type="map_display.py" output="screen"/>

  <!-- Quadrotor dynamics simulator -->
  <node pkg="so3_quadrotor_simulator" type="quadrotor_simulator_so3"
        name="drone_$(arg drone_id)_quadrotor_simulator_so3" output="screen">
    <param name="rate/odom" value="200.0"/>
    <param name="simulator/init_state_x" value="$(arg init_x)"/>
    <param name="simulator/init_state_y" value="$(arg init_y)"/>
    <param name="simulator/init_state_z" value="$(arg init_z)"/>
    <rosparam command="load" file="$(find bringup_test)/params/sim_ego_control.yaml"/>
    <param name="mass" value="$(arg uav_mass)"/>
    <param name="g" value="$(arg uav_grav)"/>
    <remap from="~odom" to="drone_$(arg drone_id)_visual_slam/odom"/>
    <remap from="~cmd" to="drone_$(arg drone_id)_so3_cmd"/>
  </node>

  <!-- Broadcast odometry as TF for external visualizers. -->
  <node pkg="bringup_test" name="drone_$(arg drone_id)_frame_tf"
        type="frame_tf.py" output="screen">
    <param name="odom_topic" value="/drone_$(arg drone_id)_visual_slam/odom"/>
  </node>

  <!-- SO(3) controller -->
  <node pkg="nodelet" type="nodelet" args="standalone so3_control/SO3ControlNodelet"
        name="drone_$(arg drone_id)_so3_control" required="true" output="screen">
    <param name="so3_control/init_state_x" value="$(arg init_x)"/>
    <param name="so3_control/init_state_y" value="$(arg init_y)"/>
    <param name="so3_control/init_state_z" value="$(arg init_z)"/>
    <remap from="~odom" to="drone_$(arg drone_id)_visual_slam/odom"/>
    <remap from="~position_cmd" to="drone_$(arg drone_id)_planning/pos_cmd"/>
    <remap from="~motors" to="drone_$(arg drone_id)_motors"/>
    <remap from="~corrections" to="drone_$(arg drone_id)_corrections"/>
    <remap from="~so3_cmd" to="drone_$(arg drone_id)_so3_cmd"/>
    <rosparam command="load" file="$(find bringup_test)/params/sim_ego_control.yaml"/>
    <param name="mass" value="$(arg uav_mass)"/>
    <param name="g" value="$(arg uav_grav)"/>
  </node>

  <!-- 360° LiDAR sensor simulation (pcl_render_node) -->
  <node pkg="local_sensing_node" type="pcl_render_node"
        name="drone_$(arg drone_id)_pcl_render_node" output="log">
    <remap from="~global_map" to="/map_generator/global_cloud/fixed"/>
    <remap from="~odometry" to="/drone_$(arg drone_id)_visual_slam/odom"/>
    <remap from="~cloud" to="$(arg cloud_out)"/>
    <remap from="~sensor_pose" to="/drone_$(arg drone_id)_pcl_render_node/camera_pose"/>
    <remap from="~depth_img" to="/drone_$(arg drone_id)_pcl_render_node/depth"/>

    <param name="drone_id" value="$(arg drone_id)"/>
    <param name="quadrotor_name" value="drone_$(arg drone_id)"/>
    <param name="uav_num" value="1"/>
    <param name="is_360lidar" value="1"/>
    <param name="sensing_horizon" value="100.0"/>
    <param name="sensing_rate" value="10.0"/>
    <param name="estimation_rate" value="10.0"/>
    <param name="polar_resolution" value="0.2"/>
    <param name="yaw_fov" value="360.0"/>
    <param name="vertical_fov" value="90.0"/>
    <param name="min_raylength" value="0.5"/>
    <param name="livox_linestep" value="1.4"/>
    <param name="curvature_limit" value="100.0"/>
    <param name="hash_cubesize" value="5.0"/>
    <param name="use_avia_pattern" value="0"/>
    <param name="use_vlp32_pattern" value="0"/>
    <param name="use_minicf_pattern" value="1"/>
    <param name="downsample_res" value="0.1"/>
    <param name="dynobj_enable" value="0"/>
    <param name="dynobject_size" value="0.6"/>
    <param name="dynobject_num" value="30"/>
    <param name="dyn_mode" value="2"/>
    <param name="dyn_velocity" value="3.0"/>
    <param name="use_uav_extra_model" value="0"/>
    <param name="collisioncheck_enable" value="0"/>
    <param name="collision_range" value="0.3"/>
    <param name="output_pcd" value="0"/>
  </node>

  <!-- prior_local support cloud merger (aligned with diff-uss-nav obj_nav.launch):
       extracts prior local cloud around current pose, merges into the raw
       simulated scan, and republishes on /livox/lidar_world so downstream
       planner configs stay unchanged -->
  <node pkg="map_generator" name="drone_$(arg drone_id)_cloud_merger"
        type="support_cloud_pub" output="screen"
        if="$(arg support_pcd_enable)">
    <param name="support_pcd_path" value="$(arg support_pcd)"/>
    <param name="prior_local_radius" value="2.0"/>
    <param name="prior_local_leaf" value="0.1"/>
    <!-- extraction shape: 0=sphere (radius), 1=box (6-direction extends below,
         yaw follows heading, up/down always along world z) -->
    <param name="prior_local_mode"          type="int"    value="1"/>
    <param name="prior_box_extend_forward"  type="double" value="2.0"/>
    <param name="prior_box_extend_backward" type="double" value="0.6"/>
    <param name="prior_box_extend_left"     type="double" value="0.6"/>
    <param name="prior_box_extend_right"    type="double" value="0.6"/>
    <param name="prior_box_extend_up"       type="double" value="1.5"/>
    <param name="prior_box_extend_down"     type="double" value="2.0"/>
    <!-- motion-threshold caching (aligned with FAST_LIO prior_local_motion_*) -->
    <param name="prior_local_motion_check"      type="bool"   value="false"/>
    <param name="prior_local_motion_thresh"     type="double" value="0.5"/>
    <param name="prior_local_motion_yaw_thresh" type="double" value="0.1"/>
    <!-- support map outlier filter (aligned with FAST_LIO prior_outlier_filter, run once at PCD load) -->
    <param name="prior_outlier_filter/enable"        type="bool"   value="true"/>
    <param name="prior_outlier_filter/type"          type="int"    value="1"/>
    <param name="prior_outlier_filter/radius"        type="double" value="0.3"/>
    <param name="prior_outlier_filter/min_neighbors" type="int"    value="30"/>
    <param name="prior_outlier_filter/mean_k"        type="int"    value="20"/>
    <param name="prior_outlier_filter/std_threshold" type="double" value="2.0"/>
    <remap from="~cloud" to="/livox/lidar_world_raw"/>
    <remap from="~odom"  to="/drone_$(arg drone_id)_visual_slam/odom"/>
    <remap from="~cloud_merged" to="/livox/lidar_world"/>
  </node>

</launch>
