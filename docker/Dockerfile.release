FROM osrf/ros:noetic-desktop-focal

SHELL ["/bin/bash", "-c"]

RUN printf '%s\n' \
  'Acquire::Retries "5";' \
  'Acquire::http::Timeout "30";' \
  'Acquire::https::Timeout "30";' \
  'Acquire::http::Pipeline-Depth "0";' \
  > /etc/apt/apt.conf.d/80-retries

# ── Layer 1: build tools (almost never changes) ────────────────────
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
  apt-get update && apt-get install -y --no-install-recommends \
  git python3-catkin-tools python3-osrf-pycommon python3-pip

# ── Layer 3: rendering libs (local_sensing 3D simulation) ──────────
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
  apt-get update && apt-get install -y --no-install-recommends \
  libgl1-mesa-dev libglu1-mesa-dev libglew-dev libglfw3-dev mesa-utils

# ── Layer 4: math / scientific computation ─────────────────────────
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
  apt-get update && apt-get install -y --no-install-recommends \
  libjpeg-dev

# ── Layer 5: headless display ──────────────────────────────────────
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
  apt-get update && apt-get install -y --no-install-recommends \
  xvfb

# ── Layer 6: ROS runtime dependencies ─────────────────────────────
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
  --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
  apt-get update && apt-get install -y --no-install-recommends \
  ros-noetic-tf ros-noetic-nodelet ros-noetic-cv-bridge \
  ros-noetic-image-transport ros-noetic-pcl-ros \
  ros-noetic-mavros ros-noetic-mavros-extras

# ── Layer 7: precompiled deps (igraph + libleidenalg) ─────────────
COPY docker/assets/igraph/libigraph.a /usr/lib/x86_64-linux-gnu/libigraph.a
COPY docker/assets/igraph/include/ /usr/include/igraph/
COPY docker/assets/igraph/cmake/ /usr/lib/x86_64-linux-gnu/cmake/igraph/

COPY docker/assets/libleidenalg/liblibleidenalg.a /usr/lib/x86_64-linux-gnu/liblibleidenalg.a
COPY docker/assets/libleidenalg/include/ /usr/include/libleidenalg/
COPY docker/assets/libleidenalg/cmake/ /usr/lib/x86_64-linux-gnu/cmake/libleidenalg/

# ── Layer 8: workspace setup ──────────────────────────────────────
RUN mkdir -p /workspace/src
WORKDIR /workspace/src

# ── Layer 9: copy ROS packages (changes per commit) ───────────────
# utils
COPY ws_main/src/utils/quadrotor_msgs ./utils/quadrotor_msgs
COPY ws_main/src/utils/traj_utils     ./utils/traj_utils

# EGO planner core
COPY ws_main/src/planners/ego_planner/plan_env       ./planners/ego_planner/plan_env
COPY ws_main/src/planners/ego_planner/path_searching ./planners/ego_planner/path_searching
COPY ws_main/src/planners/ego_planner/traj_opt       ./planners/ego_planner/traj_opt
COPY ws_main/src/planners/ego_planner/map_interface  ./planners/ego_planner/map_interface
COPY ws_main/src/planners/ego_planner/plan_manage    ./planners/ego_planner/plan_manage

# UAV simulator
COPY ws_main/src/uav_simulator /workspace/src/uav_simulator

# Camera FOV
COPY ws_main/src/perception/camera_fov ./perception/camera_fov

# LKH TSP solver
# (removed - was only used by exploration)

# Scene graph + mission executive
COPY ws_main/src/perception/global_belief    ./perception/global_belief
COPY ws_main/src/perception/scene_graph     ./perception/scene_graph
COPY ws_main/src/mission_executive          ./mission_executive

# ── Layer 10: artifacts directory ──────────────────────────────────
RUN mkdir -p /workspace/.artifacts/{pcd,csv}

# ── Layer 11: C++ build (slow, cached) ─────────────────────────────
WORKDIR /workspace
RUN source /opt/ros/noetic/setup.bash && \
  catkin init && \
  catkin build \
  quadrotor_msgs traj_utils \
  plan_env path_searching traj_opt map_interface \
  so3_quadrotor_simulator so3_control local_sensing_node map_generator \
  camera_fov \
  global_belief scene_graph mission_executive \
  ego_planner \
  --cmake-args -DCMAKE_BUILD_TYPE=Release -DCMAKE_CXX_FLAGS="-w" -DCMAKE_POLICY_DEFAULT_CMP0148=OLD -DCMAKE_POLICY_VERSION_MINIMUM=3.5

# ── Layer 12: bringup (fast, rebuilt on launch/config change) ──────
COPY bringup_test /workspace/src/bringup_test
RUN source /opt/ros/noetic/setup.bash && \
  source /workspace/devel/setup.bash && \
  catkin build bringup_test

# ── Layer 13: entrypoint ───────────────────────────────────────────
COPY docker/entrypoint-release.sh /entrypoint-release.sh
RUN chmod +x /entrypoint-release.sh
ENTRYPOINT ["/entrypoint-release.sh"]
