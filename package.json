{
  "name": "uss-nav",
  "private": true,
  "type": "module",
  "scripts": {
    "render:view": "cd tools/md2html && bun render.ts --multi ../../_site/VIEW.html EGO:../../docs/EGO.md SCENEGRAPH:../../docs/SCENEGRAPH.md NEXT_SCENEGRAPH:../../docs/NEXT_SCENEGRAPH.md",
    "render:scenegraph": "cd tools/md2html && bun render.ts ../../docs/SCENEGRAPH.md ../../_site/SCENEGRAPH.html",
    "render:ego": "cd tools/md2html && bun render.ts ../../docs/EGO.md ../../_site/EGO.html",
    "render:next_scenegraph": "cd tools/md2html && bun render.ts ../../docs/NEXT_SCENEGRAPH.md ../../_site/NEXT_SCENEGRAPH.html",
    "view": "cd tools/md2html && bun run view",
    "view:scenegraph": "cd tools/md2html && bun run view:scenegraph",
    "view:ego": "cd tools/md2html && bun run view:ego",
    "view:next_scenegraph": "cd tools/md2html && bun run view:next_scenegraph",

    "doxygen": "bun tools/doxygen/render.ts",
    "test:llm-mode": "bun src/cli/index.ts explore",
    "server": "bun src/server/index.ts",
    "dashboard": "bun src/cli/index.ts dashboard"
  },
  "dependencies": {
    "@langchain/langgraph": "^1.4.7",
    "@langchain/openai": "^1.5.5",
    "mqtt": "^5.15.1",
    "zod": "3"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.7.0"
  }
}
